# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://captain:yourpassword@localhost:5432/captaintaxi

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+13069990000   # Captain Taxi's Twilio number (E.164)

# ── Email — choose ONE provider ───────────────────────────────────────────────
# SendGrid (preferred)
SENDGRID_API_KEY=SG...

# SMTP fallback
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=dispatch@captaintaxi.ca
# SMTP_PASSWORD=...

FROM_EMAIL=dispatch@captaintaxi.ca
FROM_NAME=Captain Taxi

# ── Owner contact ─────────────────────────────────────────────────────────────
OWNER_EMAIL=owner@captaintaxi.ca
OWNER_PHONE=+13061234567           # E.164 format
OWNER_NAME=Captain Taxi Owner

# ── App ───────────────────────────────────────────────────────────────────────
BASE_URL=https://captaintaxi.ca
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Coverage minimums (drivers per city per time block) ───────────────────────
MIN_DRIVERS_SASKATOON_DAY=4
MIN_DRIVERS_SASKATOON_NIGHT=2
MIN_DRIVERS_REGINA_DAY=3
MIN_DRIVERS_REGINA_NIGHT=2

# ── Performance thresholds ────────────────────────────────────────────────────
CANCELLATION_RATE_THRESHOLD=0.10   # 10%
RATING_THRESHOLD=4.0
COMPLAINT_THRESHOLD_DAYS=30
COMPLAINT_THRESHOLD_COUNT=3
