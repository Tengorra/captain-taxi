[Unit]
Description=Captain Taxi Customer Service Agent
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=notify
User=captaintaxi
Group=captaintaxi
WorkingDirectory=/opt/captain-taxi
EnvironmentFile=/opt/captain-taxi/.env
ExecStart=/opt/captain-taxi/venv/bin/gunicorn \
    --config /opt/captain-taxi/customer/deploy/gunicorn.conf.py \
    "captain_taxi.customer.main:app"
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=captain-taxi-customer

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/captain-taxi /opt/captain-taxi

[Install]
WantedBy=multi-user.target
