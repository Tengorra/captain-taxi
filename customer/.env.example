# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
BASE_URL=https://customer.captain.taxi

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Your Twilio WhatsApp-enabled number (or sandbox: +14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM_SASKATOON=+13062420000
TWILIO_SMS_FROM_REGINA=+13067752222

# ── Vapi ──────────────────────────────────────────────────────────────────────
VAPI_API_KEY=...
# Get these from the Vapi dashboard after importing your phone numbers
VAPI_PHONE_NUMBER_ID_SASKATOON=
VAPI_PHONE_NUMBER_ID_REGINA=
# Optional: set a shared secret for webhook signature verification
VAPI_WEBHOOK_SECRET=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://captaintaxi:CHANGE_ME@localhost:5432/captaintaxi

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Dispatch Agent ────────────────────────────────────────────────────────────
DISPATCH_AGENT_URL=http://localhost:8001
DISPATCH_AGENT_API_KEY=

# ── Business ─────────────────────────────────────────────────────────────────
# Owner phone for serious complaint escalation alerts
OWNER_PHONE=+1306XXXXXXX
OWNER_EMAIL=owner@captain.taxi
