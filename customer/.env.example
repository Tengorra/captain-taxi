# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
BASE_URL=https://customer.captaintaxi.ca

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Your Twilio WhatsApp-enabled number (or sandbox: +14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM_SASKATOON=+13062420000
TWILIO_SMS_FROM_REGINA=+13067752222

# ── ElevenLabs Conversational AI ─────────────────────────────────────────────
# Create the agent in https://elevenlabs.io/app/conversational-ai, then paste:
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Set on the agent's "Webhooks" tab — used to verify ElevenLabs-Signature headers
ELEVENLABS_WEBHOOK_SECRET=
# Twilio numbers the agent answers on (connect via the agent's "Phone numbers" tab)
TWILIO_VOICE_SASKATOON=+13062420000
TWILIO_VOICE_REGINA=+13067752222

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://captaintaxi:CHANGE_ME@localhost:5432/captaintaxi

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Dispatch Agent ────────────────────────────────────────────────────────────
DISPATCH_AGENT_URL=http://localhost:8001
DISPATCH_AGENT_API_KEY=

# ── Business ─────────────────────────────────────────────────────────────────
# Owner phone for serious complaint escalation alerts
OWNER_PHONE=+1306XXXXXXX
OWNER_EMAIL=owner@captaintaxi.ca
