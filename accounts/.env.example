# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://captain:secret@localhost:5432/captain_taxi

# ── QuickBooks Online ─────────────────────────────────────────────────────────
QB_CLIENT_ID=your_qb_client_id
QB_CLIENT_SECRET=your_qb_client_secret
QB_REDIRECT_URI=https://your-domain.com/accounts/qb/callback
QB_ENVIRONMENT=production          # sandbox | production
QB_REALM_ID=                       # filled after first OAuth login

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio (SMS) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+13062420000

# ── SendGrid (Email) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG...
EMAIL_FROM=accounts@captain.taxi
EMAIL_FROM_NAME=Captain Taxi Accounts

# ── Business Settings ─────────────────────────────────────────────────────────
DRIVER_COMMISSION_RATE=0.75        # driver keeps 75 %
COMPANY_GST_NUMBER=123456789RT0001
OWNER_EMAIL=owner@captain.taxi
OWNER_PHONE=+13061234567
AMARA_EMAIL=amara@captain.taxi
AMARA_PHONE=+13061234568

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
APP_BASE_URL=https://your-domain.com
LOG_LEVEL=INFO
