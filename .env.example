# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=captaintaxi
POSTGRES_USER=captaintaxi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXX

# ── Twilio (WhatsApp / SMS) ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Owner contacts (DO NOT SHARE) ────────────────────────────────────────────
OWNER_PHONE=+13068811542
AMARA_PHONE=+13068500760
OWNER_EMAIL=owner@captaintaxi.ca

# ── Company ───────────────────────────────────────────────────────────────────
COMPANY_NAME=Captain Taxi
SASKATOON_PHONE=306-242-0000
REGINA_PHONE=306-775-2222

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
ENVIRONMENT=production
LOG_LEVEL=INFO
DIGEST_HOUR=8
DIGEST_MINUTE=0

# ── QuickBooks ────────────────────────────────────────────────────────────────
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REFRESH_TOKEN=
QB_REALM_ID=

# ── BOT (ElevenLabs voice dispatcher, service on :8007) ───────────────────────
# Get the API key + Agent ID from elevenlabs.io → Conversational AI → Agents.
# The webhook secret is whatever you set as the "Signing secret" on the agent's
# webhook config; leave empty to skip HMAC verification during local testing.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Live human dispatcher numbers — the bot warm-transfers here on escalation.
# Default to the public taxi lines; override if you want bot escalations to
# ring a separate desk.
HUMAN_DISPATCHER_SASKATOON=+13062420000
HUMAN_DISPATCHER_REGINA=+13067752222

# Caller-ID used on the outbound leg of warm-transfers. Defaults to the
# customer-service Twilio number if unset.
# TWILIO_PHONE_FROM=+16393983373

