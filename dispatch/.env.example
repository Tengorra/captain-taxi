# ── App ───────────────────────────────────────────────
APP_NAME="Captain Taxi Dispatch"
DEBUG=false
SECRET_KEY=change-me-in-production

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/captain_taxi
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/captain_taxi

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DRIVER_LOCATION_TTL=300

# ── Anthropic ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ── Twilio ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+13065550000

# ── Assignment ────────────────────────────────────────
ASSIGNMENT_TIMEOUT_SECONDS=90
MAX_ASSIGNMENT_RADIUS_KM=15.0
NEARBY_DRIVERS_LIMIT=10
